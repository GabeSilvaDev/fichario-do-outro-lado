rules_version = '2';

service cloud.firestore {
  match /databases/{db}/documents {

    function logado()  { return request.auth != null; }
    function uid()     { return request.auth.uid; }
    function mesa(id)  { return get(/databases/$(db)/documents/mesas/$(id)).data; }
    function souMestre(id) { return logado() && mesa(id).mestreUid == uid(); }
    function souMembro(id) {
      return logado() &&
        exists(/databases/$(db)/documents/mesas/$(id)/membros/$(uid()));
    }

    function reassumindo(id) {
      let pedido = get(/databases/$(db)/documents/mesas/$(id)/privado/pedido).data;
      let guardada = get(/databases/$(db)/documents/mesas/$(id)/privado/chave).data;
      return logado() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['mestreUid']) &&
        request.resource.data.mestreUid == uid() &&
        pedido.uid == uid() &&
        pedido.chave == guardada.chave;
    }

    match /codigos/{codigo} {
      allow get: if logado();
      allow list: if false;
      allow create: if logado() &&
        get(/databases/$(db)/documents/mesas/$(request.resource.data.mesaId))
          .data.mestreUid == uid();
      allow delete: if logado() &&
        get(/databases/$(db)/documents/mesas/$(resource.data.mesaId))
          .data.mestreUid == uid();
      allow update: if false;
    }

    match /mesas/{mesaId} {
      allow read:   if souMembro(mesaId) || souMestre(mesaId);
      allow create: if logado() && request.resource.data.mestreUid == uid();
      allow update: if souMestre(mesaId) || reassumindo(mesaId);
      allow delete: if souMestre(mesaId);

      match /galeria/{imagemId} {
        allow read:  if souMembro(mesaId) || souMestre(mesaId);
        allow write: if souMestre(mesaId);
      }

      match /imagens/{imagemId} {
        allow read:  if souMembro(mesaId) || souMestre(mesaId);
        allow write: if souMestre(mesaId);
      }

      match /privado/chave {
        allow read: if false;
        allow create: if souMestre(mesaId);
        allow update: if false;
        allow delete: if souMestre(mesaId);
      }
      match /privado/pedido {
        allow read: if false;
        allow create, update: if logado();
        allow delete: if souMestre(mesaId);
      }

      match /membros/{membroUid} {
        allow read: if souMembro(mesaId) || (logado() && membroUid == uid());
        allow create, update: if logado() && membroUid == uid();
        allow delete: if logado() && (membroUid == uid() || souMestre(mesaId));
      }

      // Só quem está na mesa publica ficha nela: sem isso, qualquer um com
      // o id da mesa punha ficha no painel do mestre.
      match /fichas/{donoUid} {
        allow read:  if logado() && (donoUid == uid() || souMestre(mesaId));
        allow write: if logado() && donoUid == uid() &&
          (souMembro(mesaId) || souMestre(mesaId));
        allow delete: if souMestre(mesaId);
      }

      match /rolagens/{rolagemId} {
        allow read: if souMembro(mesaId) || souMestre(mesaId);
        allow create: if (souMembro(mesaId) || souMestre(mesaId)) &&
          request.resource.data.porUid == uid();
        allow update: if false;
        allow delete: if souMestre(mesaId);
      }

      match /mapas/{imagemId} {
        allow read:  if souMembro(mesaId) || souMestre(mesaId);
        allow write: if souMestre(mesaId);
      }
      match /mapasImagens/{imagemId} {
        allow read:  if souMembro(mesaId) || souMestre(mesaId);
        allow write: if souMestre(mesaId);
      }

      match /mapa/{doc} {
        allow read:  if souMembro(mesaId) || souMestre(mesaId);
        allow write: if souMestre(mesaId);

        // Uma peça por documento. O mestre mexe em todas; o jogador só na
        // dele (id = uid): cria quando publica a ficha, move e muda o
        // tamanho, acompanha nome e foto, e tira ao sair. Cor, marca de
        // ameaça e as peças dos outros continuam do mestre.
        match /pecas/{pecaId} {
          function escalaOk(d) {
            return d.escala is number && d.escala >= 0.4 && d.escala <= 3;
          }
          function posicaoOk(d) {
            return d.x is number && d.x >= 0 && d.x <= 1 &&
                   d.y is number && d.y >= 0 && d.y <= 1;
          }
          function minha() { return souMembro(mesaId) && pecaId == uid(); }

          allow read:   if souMembro(mesaId) || souMestre(mesaId);
          allow write:  if souMestre(mesaId);
          allow create: if minha() &&
            request.resource.data.id == uid() &&
            request.resource.data.inimigo == false &&
            escalaOk(request.resource.data) &&
            posicaoOk(request.resource.data);
          allow update: if minha() &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['x', 'y', 'escala', 'nome', 'retrato']) &&
            escalaOk(request.resource.data) &&
            posicaoOk(request.resource.data);
          allow delete: if minha();
        }
      }

      match /mural/{doc} {
        allow read:  if souMembro(mesaId) || souMestre(mesaId);
        allow write: if souMestre(mesaId);
      }
    }
  }
}
